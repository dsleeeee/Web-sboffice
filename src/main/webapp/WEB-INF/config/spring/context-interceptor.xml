<?xml version="1.0" encoding="UTF-8"?>
<beans
  xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:mvc="http://www.springframework.org/schema/mvc"

  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd
                           http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

  <mvc:interceptors>

    <!-- Request 로 들어오는 locale 을 변경하기 위한 Interceptor -->
    <bean class="org.springframework.web.servlet.i18n.LocaleChangeInterceptor">
      <!-- 다국어 변경 파라미터 이름 ln=en, ln=kr, ln=th -->
      <property name="paramName" value="ln" />
    </bean>

    <!-- 사용자 인증 확인 -->
    <mvc:interceptor>
      <!-- 모든 URL -->
      <mvc:mapping path="/**" />
      <!-- 예외 URL -->
      <mvc:exclude-mapping path="/" />
      <mvc:exclude-mapping path="/resource/**" />
      <mvc:exclude-mapping path="/error/*.sb" />
      <mvc:exclude-mapping path="/auth/log*.sb" />
      <mvc:exclude-mapping path="/user/*.sb" />

      <mvc:exclude-mapping path="/menu/*.sb" />

      <mvc:exclude-mapping path="/system/user/info/modifyPasswd.sb" />

      <mvc:exclude-mapping path="/application/pos/posLogin.sb" />
	  <mvc:exclude-mapping path="/sample/tonymory/*.sb" />
      <mvc:exclude-mapping path="/mobile/auth/log*.sb" />
      <mvc:exclude-mapping path="/mobile/user/*.sb" />
      <mvc:exclude-mapping path="/mobile/direct/mobileDirectLogin.sb" />

      <!-- NHN KCP 본인확인 V2 결과 콜백 (인증 팝업 브라우저가 Ret_URL로 POST) -->
      <!--
        V1 Ret_URL의 sid 세션복원 → V2 KcpCertService.getTransaction()의 요청자 검증.
        callback만 AuthenticationInterceptor에서 제외하며 거래등록 API는 로그인 세션이 필요하다.
      -->
      <mvc:exclude-mapping path="/adi/sms/smsUserRegist/smsUserRegist/updateVerify.sb" />
      <mvc:exclude-mapping path="/adi/sms/smsTelNoManage/smsTelNoManage/getSmsTelNoRegisterRequest.sb" />
      <mvc:exclude-mapping path="/adi/sms/marketingSmsSend/marketingSmsSend/updateVerify.sb" />
      <mvc:exclude-mapping path="/adi/sms/marketingSmsSend/marketingSmsSend/updateVerify2.sb" />
	  
      <bean class="kr.co.common.interceptor.AuthenticationInterceptor" />
    </mvc:interceptor>

  </mvc:interceptors>

</beans>
