<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd" >
<properties>

  <comment>Solbipos Office Local Config Properties</comment>

  <!-- =====================================--> 
  <!--  MAIN Properties--> 
  <!-- =====================================-->
  <entry key="profile">local</entry>
  <entry key="domain">http://neo.solbipos.com</entry>
  <entry key="encoding">UTF-8</entry>
  <entry key="welcome.url">/auth/login.sb</entry>
  
  <!-- =====================================--> 
  <!--  JDBC Properties--> 
  <!-- =====================================-->
  <entry key="jndi.main.jdbc.name">jdbc/oracle/sb</entry> 


  <!-- =====================================--> 
  <!--  tiles Properties--> 
  <!-- =====================================-->
  <entry key="tiles.path">/WEB-INF/config/tiles-layout.xml</entry>
  
  
  <!-- ====================================--> 
  <!--  Redis Properties--> 
  <!-- ====================================-->
  <entry key="redis.hostName">192.168.0.160</entry>
  <entry key="redis.port">6379</entry>
  <entry key="redis.password"></entry>
  <entry key="redis.usePool">true</entry>
<!--   web session  -->
  <entry key="redis.web.prefix">sbp:web:local:</entry>
<!--   web 공통 코드  -->
  <entry key="redis.code.prefix">sbp:cmm:local:</entry>  

  <!-- NHN KCP 본인확인 V2 (테스트 컨텍스트용) -->
  <!--
    V1 Controller 상수 → V2 KcpCertServiceImpl/KcpCertTransactionStore 주입값.
    Spring 테스트 context용이며 실제 WAR에는 포함되지 않는다.
  -->
  <entry key="kcp.cert.v2.siteCd">AO7F3</entry>
  <entry key="kcp.cert.v2.webSiteId"></entry>
  <entry key="kcp.cert.v2.encKey">c2a22fa3ebe4698075bcac6b433d52e351c881b02fb83488d4283a43385b1f8e</entry>
  <entry key="kcp.cert.v2.registerUrl">https://testcert.kcp.co.kr/api/reg/certDataReg.do</entry>
  <entry key="kcp.cert.v2.queryUrl">https://testcert.kcp.co.kr/api/query/getCertData.do</entry>
  <entry key="kcp.cert.v2.returnBaseUrl">http://localhost:8080</entry>
  <entry key="kcp.cert.v2.connectTimeoutMs">5000</entry>
  <entry key="kcp.cert.v2.readTimeoutMs">10000</entry>
  <entry key="kcp.cert.v2.transactionTtlMinutes">15</entry>
  
  
  <!-- ====================================--> 
  <!--  login Properties--> 
  <!-- ====================================-->
<!--   패스워드 변경 유효기간 -->
  <entry key="login.pwd.chg.days">90</entry>
  <entry key="login.check.id.save">saveid</entry>
  <entry key="login.otp.limit.minute">3</entry>
  <entry key="login.otp.size">4</entry>
  <entry key="login.fail.check.cnt">3</entry>
  
  <!-- ====================================--> 
  <!--  session Properties--> 
  <!-- ====================================-->
<!--   세션 타임 타웃 분단위 -->
  <entry key="session.timeout.min">30</entry>
  <entry key="session.hist.menu.size">10</entry>
  
  
  <!-- 아래는 기존에 treepay 에서 쓰던것 -->
  <entry key="excel.font">돋움</entry>
  <entry key="excel.tempDir">/temp_excel</entry>
  <entry key="email.host">192.168.0.1</entry>
  <entry key="email.port">31901</entry>
  
  <!-- 파일업로드 관련 -->
  <entry key="file.upload.dir">/FileRoot/</entry>
  
  <!-- 공통 변수 저장소 명칭 관련 -->
  <entry key ="baseEnv.prop.env">env</entry>
  
</properties>
